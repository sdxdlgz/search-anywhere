# Copy this file to .env; the server loads it automatically. Do not commit secrets.
SA_HOST=127.0.0.1
SA_PORT=8765
SA_DATA_DIR=.data
# Optional: at least 16 characters. Otherwise .data/admin-token.txt is generated.
# SA_ADMIN_TOKEN=
# Optional browser origins allowed for /mcp and /v1 only, comma-separated.
# SA_ALLOWED_ORIGINS=https://your-client.example
# Trusted reverse proxy: loopback for a native local proxy; 1 for exactly one proxy
# in front of the Docker service, whose published port must stay on 127.0.0.1.
# Explicit proxy IPs/CIDRs (comma-separated) are also accepted.
# SA_TRUST_PROXY=loopback
# Docker Compose only: pin a published sha-* tag or image digest for repeatable updates.
# SA_IMAGE=ghcr.io/sdxdlgz/search-anywhere:latest
# SA_BIND=127.0.0.1
