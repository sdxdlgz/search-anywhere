# Copy this file to .env; the server loads it automatically. Do not commit secrets.
SA_HOST=127.0.0.1
SA_PORT=8765
SA_DATA_DIR=.data
# Optional: at least 16 characters. Otherwise .data/admin-token.txt is generated.
# SA_ADMIN_TOKEN=
# Optional browser origins allowed for /mcp and /v1 only, comma-separated.
# SA_ALLOWED_ORIGINS=https://your-client.example
# Only if a trusted local reverse proxy terminates HTTPS and sets X-Forwarded-Proto.
# Keep SA_HOST=127.0.0.1 when using this option.
# SA_TRUST_PROXY=loopback
